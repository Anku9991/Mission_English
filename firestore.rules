rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection (For Admins)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Secure Pins Collection
    match /secure_pins/{studentId} {
      allow read, write: if isAdmin();
    }

    // Tests/Courses Collection
    match /tests/{testId} {
      // Anyone authenticated can read test metadata (title, price, type)
      allow read: if isAuthenticated();
      // Only admins can create, update, delete tests
      allow write: if isAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      // Users can create and read their own payments
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      // Admins can read and update (approve/reject) all payments
      allow read, update: if isAdmin();
    }

    // Results Collection
    match /results/{resultId} {
      // Users can read and create their own results
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      // Admins can view all results
      allow read: if isAdmin();
    }
  }
}
