rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection (For Admins)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.uid == request.auth.uid ||
        request.auth.token.email == (studentId.lower() + '@me.com')
      );
      allow update: if isAuthenticated() && request.auth.token.email == (studentId.lower() + '@me.com');
      allow write: if isAdmin();
    }

    // Secure Pins Collection
    match /secure_pins/{studentId} {
      allow read, write: if isAdmin();
    }

    // Courses Collection
    match /courses/{courseId} {
      // Anyone authenticated can read course metadata
      allow read: if isAuthenticated();
      // Only admins can create, update, delete courses
      allow write: if isAdmin();
    }

    // Payment Requests Collection
    match /payment_requests/{paymentId} {
      // Users can create and read their own payments
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      // Admins can read and update (approve/reject) all payments
      allow read, update: if isAdmin();
    }

    // Results Collection
    match /results/{resultId} {
      // Users can read and create their own results
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      // Admins can view all results
      allow read: if isAdmin();
    }
  }
}
