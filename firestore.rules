rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Users Collection (For Admins)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.uid == request.auth.uid ||
        request.auth.token.email == (studentId.lower() + '@me.com') ||
        request.auth.uid == studentId
      );
      allow create: if isAuthenticated() && request.auth.uid == studentId;
      allow update: if isAuthenticated() && (request.auth.token.email == (studentId.lower() + '@me.com') || request.auth.uid == studentId);
      allow write: if isAdmin();
    }

    // Secure Pins Collection
    match /secure_pins/{studentId} {
      allow read, write: if isAdmin();
    }

    // Courses Collection
    match /courses/{courseId} {
      // Anyone authenticated can read course metadata
      allow read: if isAuthenticated();
      // Only admins can create, update, delete courses
      allow write: if isAdmin();
    }

    // Payment Requests Collection
    match /payment_requests/{paymentId} {
      // Users can create and read their own payments
      allow create: if isAuthenticated() && request.auth.token.email == (request.resource.data.studentId.lower() + '@me.com');
      allow read: if isAuthenticated() && request.auth.token.email == (resource.data.studentId.lower() + '@me.com');
      // Admins can read and update (approve/reject) all payments
      allow read, update: if isAdmin();
    }

    // Results Collection
    match /results/{resultId} {
      // Users can create and read their own results
      allow create: if isAuthenticated() && request.auth.token.email == (request.resource.data.studentId.lower() + '@me.com');
      allow read: if isAuthenticated() && request.auth.token.email == (resource.data.studentId.lower() + '@me.com');
      // Admins can view and update (publish) all results
      allow read, update, delete: if isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      // Anyone authenticated can read global settings (like payment UPI details)
      allow read: if isAuthenticated();
      // Only admins can update settings
      allow write: if isAdmin();
    }
  }
}
